        return 0;
    }

    if( events & KEY_I2C_WRITE_DATA_EVT)
    {
        int ret;

					LOG("ADDR:%02X\r\n",SelectIICAddr());
					IICTest();

        return (events ^ KEY_I2C_WRITE_DATA_EVT);
    }

//    if( events & KEY_I2C_READ_DATA_EVT)
