/*******软件IIC添加的代码*********/
/****************************************************************************
* 函数名         ：IIC_SDA_CHANGE_IN
* 函数功能       ：SDA引脚切换为输入模式
* 输入           ：无
* 输出           ：无
****************************************************************************/
void IIC_SDA_CHANGE_IN(void)
{
	hal_gpio_pin_init(I2C_MASTER_SDA,IE);   //IE--输入
}
/****************************************************************************
* 函数名         ：IIC_SDA_CHANGE_OUT
* 函数功能       ：SDA引脚切换为输出模式
* 输入           ：无
* 输出           ：无
****************************************************************************/
void IIC_SDA_CHANGE_OUT(void)
{
		hal_gpio_pin_init(I2C_MASTER_SDA,OEN);   //OEN--输出
}




/*********************************************************************************
* Function    : Delay_us
* Description : us delay. 
* Input       : delay period, measured as us  
* Output      : none  
* Author      :      
* 作用        ： 微秒延时（误差在+ - 3us左右）只适用于64MHz主频
**********************************************************************************/
void Delay_us(uint32_t fu32_Delay)
{
	while (fu32_Delay--)
	{		

		for (int i=2;i>0;i--)
		{
				__NOP();__NOP();__NOP();__NOP();
		}
	}
}





/*******************************************************************************
* 函 数 名         : IIC_Start
* 函数功能		   		: IIC起始信号
* 输    入         :  无
* 输    出         : 无
*******************************************************************************/

void IIC_Start(void)
{
	/**注意：在起始信号和停止信号 SDA要 比SCL先改变**/
	IIC_SDA_H;//拉高数据线
	IIC_SCL_H;//拉高时钟线
//	Delay_us(5 - 1);
	Delay_us(DELAY_TIME);//延时
	IIC_SDA_L;//拉低数据线
//	Delay_us(5 - 1);
	Delay_us(DELAY_TIME);//延时
	
}


/*******************************************************************************
* 函 数 名         : IIC_RecAck
* 函数功能		   		: IIC接收1bit应答
* 输    入         : 无
* 输    出         : u8 从机发送过来的应答	0：应答	1：非应答
*******************************************************************************/
u8 IIC_RecAck(void)
{
	u8 ack = 0;

//	IIC_SDA_H;//IO切换为输入
	
//	Delay_us(DELAY_TIME);
	
	IIC_SCL_L;			//拉低时钟线，准备发送数据
	IIC_SDA_L;
	IIC_SDA_CHANGE_IN();	//改变引脚为输入模式
	Delay_us(2);
	IIC_SCL_H;			//拉高时钟线，准备接收数据
	/**Delay_us**/
	Delay_us(DELAY_TIME);
	if(IIC_SDA_IN)
	{
		ack |= 1;
	}
	
	IIC_SCL_L;//拉低时钟线，保证周期完整
	Delay_us(DELAY_TIME);
	IIC_SDA_CHANGE_OUT();	//改变引脚为输出模式
	Delay_us(DELAY_TIME);	//和以上Delay_us替换使用
	

	
	return ack;
	
	
}

/*******************************************************************************
* 函 数 名         : IIC_SendAck
* 函数功能		   : IIC发送1bit应答
* 输    入         : u8 ack
* 输    出         : 无
*******************************************************************************/
void IIC_SendAck(u8 ack)
{

	IIC_SCL_L;//主机拉低时钟线，准备发送数据
	IIC_SDA_L;
	IIC_SDA_CHANGE_OUT();  //改变引脚为输出模式
//	Delay_us(DELAY_TIME);
	if (ack)
	{
	    
		IIC_SDA_H;//逻辑1
		Delay_us(DELAY_TIME);
	}
	else
	{
		IIC_SDA_L;//逻辑0
		Delay_us(DELAY_TIME);
	}
//	Delay_us(DELAY_TIME);
	IIC_SCL_H;//主机拉高时钟线，准备接收数据
	Delay_us(DELAY_TIME);
	
	IIC_SCL_L;	//拉低时钟线，保证周期完整
	Delay_us(DELAY_TIME);	
	
}



/*******************************************************************************
* 函 数 名         : IIC_SendData_byte
* 函数功能		   : IIC发送8bit数据，接收1bit应答
* 输    入         : u8 data	主机发送8bit数据
* 输    出         : u8 ack		接收从机应答		0：正常响应		1：非正常响应
*******************************************************************************/

u8 IIC_SendData_byte(u8 data)
{
	u8 ack=0;
	u8 i;
	for (i=0;i<8;i++)
	{
		IIC_SCL_L;//拉低时钟线，准备发送数据
		if(data & (0x80 >> i))//高位先出
		{
			IIC_SDA_H;//逻辑1
		}
		else
		{
			IIC_SDA_L;//逻辑0
		}
		Delay_us(DELAY_TIME);
		
		IIC_SCL_H;
		Delay_us(DELAY_TIME);
	}
	
	ack = IIC_RecAck();	//发送完8bit后，接收1bit应答
	
	return ack;
	
}




/*******************************************************************************
* 函 数 名         : IIC_RecData_byte
* 函数功能		   : IIC接收8bit数据，发送1bit应答
* 输    入         : u8 ack		发送给从机应答      0：正常响应		1：非正常响应
* 输    出         :u8 data	接收从机发送8bit数据		                    
*******************************************************************************/
u8 IIC_RecData_byte(u8 ack)
{
	u8 i;
	u8 data=0;
	
	IIC_SDA_H;//切换为输入模式
	IIC_SDA_CHANGE_IN();  //改变引脚为输入模式
	
	for(i=0;i<8;i++)
	{
		IIC_SCL_L;//拉低时钟线，准备发送数据
		Delay_us(DELAY_TIME);
		IIC_SCL_H;//拉高时钟线，准备接收数据
		data <<= 1;
		if(IIC_SDA_IN)//IO接收到高电平
		{
			data |= 1;
		}
		Delay_us(DELAY_TIME);
	}
	
//	IIC_SDA_CHANGE_OUT();  //改变引脚为输出模式
	IIC_SendAck(ack);
	return data;
}






/*******************************************************************************
* 函 数 名         : IIC_Stop
* 函数功能		   : IIC停止信号
* 输    入         : 无
* 输    出         : 无
*******************************************************************************/
void IIC_Stop(void)
{
	/**注意：在起始信号和停止信号 SDA要 比SCL先改变**/
	IIC_SDA_L;//拉低数据线
	IIC_SCL_H;//拉高时钟线
	Delay_us(DELAY_TIME);
	IIC_SDA_H;//拉高数据线
	Delay_us(DELAY_TIME);
	
	
}









/****************************************************************************
* 函数名         ：IIC_SendData
* 函数功能       ：IIC发送数据包
* 输入           ：u8 addr    从机地址
									 u8 *data		要发送的数据包（例 数组）
									 u8 len			要发送的数据的个数（例 数组里有多少个元素（下标））
* 输出           ：u8  为0时，发送正常
****************************************************************************/
u8 IIC_SendData(u8 addr, u8 *data, u8 len)
{
	int i = 0;			
	IIC_Start();			//起始信号
	
	if (IIC_SendData_byte(addr))		//发送从机地址,判断应答
	{
		return 1;
	}
	
	
	for (i = 0;i < len; i++)
	{
		if (IIC_SendData_byte(*(data++)))  //发送数据,判断应答
		{
			return 2;
		}

	}
	IIC_Stop();

	return 0;
}


/****************************************************************************
* 函数名         ：IIC_RecData
* 函数功能       ：IIC接收数据包
* 输入           ：u8 addr 从机8位地址
									u8 cmd		命令
									u8 *data		要存放接收的数据包（例 数组）
									u8 len			要存放的数据的个数（例 数组里有多少个元素（下标））
* 输出           ：u8 					为0时，接收正常
****************************************************************************/
u8 IIC_RecData(u8 addr, u8 cmd, u8 *data, u8 len)
{
	int i = 0;
	IIC_Start();			//起始信号
	
	while (IIC_SendData_byte(addr) != I2C_OK)		//发送从机地址,判断应答
	{
		IIC_Stop();
//		return 1;
		Delay_us(10);
		i++;
		if (i > 5)
		{
			return 1;
		}
		IIC_Start();			//起始信号
	}
	
	
	if (IIC_SendData_byte(cmd))		//发送从机地址,判断应答
	{
		return 2;
	}
	
	IIC_Start();			//起始信号
	
	if (IIC_SendData_byte(addr | 1))		//发送从机地址,判断应答
	{
		return 3;
	}
	
	for (i = 0;i < len - 1; i++)
	{
		*(data++) = IIC_RecData_byte(0);

	}
	*(data++) = IIC_RecData_byte(1);
	
	IIC_Stop();

	return 0;
}




u8 SelectIICAddr(void)
{
    u8 ChipAddr = 0;

    if (IIC_SendData(0x60, NULL, 0) == I2C_OK)
    {
        ChipAddr = 0x60;
    }
    else if (IIC_SendData( 0x62, NULL, 0) == I2C_OK)
    {
        ChipAddr = 0x62;
    }
    else if (IIC_SendData( 0x64, NULL, 0) == I2C_OK)
    {
        ChipAddr = 0x64;
    }
    else if (IIC_SendData( 0x66, NULL, 0) == I2C_OK)
    {
        ChipAddr = 0x66;
    }
    else
    {
        return ChipAddr;
    }
	
    return ChipAddr;
}


void IICTest(void)
{
	u8 CmdBuf[0x20] = {0x40, 0x5A, 0x02, 0x01, 0x00};
	u8 CmdLen = 5;
	u8 ReadAddr;
	
//	User_I2C_Init();	//GPIOP8 GPIOP9 100K
//	PowerON();
	
	ReadAddr = SelectIICAddr();					//遍历地址，直到当前检测芯片回应
	LOG("Addr: %02X\r\n", ReadAddr);
	ReadChipAddr = ReadAddr;
	ReadOemCmd(CmdBuf, CmdLen);
}


u8 ReadOemCmd(u8* CmdBuf, u8 CmdLen)
{
    int i;
    u8 cnt;

	u8 IIC_RxBuf[0x100];
	u8 RxLengthBuf;
	
	u8 tmp_Buf[0x100] = {0};
    u8 SEND_80_BUF[1] = {0x80};
    u8 SEND_82_BUF[1] = {0x82};
    u8 Receive_Len_Buf[2];
    u8 ReDataBuf[0x100];
   
    u16 cal_crc_temp;
    u16 data_crc_temp;

	
    MemsetData(IIC_RxBuf, 0, 0x100);
    //------------------------------------------
    //例如传入 0x40, 0x5A, 0x02, 0x01, 0x00
    //------------------------------------------
    //计算发送命令的CRC
    tmp_Buf[0] = CmdBuf[1];           //5A
    for (i = 0; i < CmdLen - 3; i++)
    {
        tmp_Buf[i + 1] = CmdBuf[3 + i]; //01 00
    }
    cal_crc_temp = GetCrc16(tmp_Buf, CmdLen - 2);

    //-------------------------------------
    //将传进的命令加上CRC，存到tmp_buf中
    for (i = 0; i < CmdLen; i++)
    {
        tmp_Buf[i] = CmdBuf[i];
    }
    tmp_Buf[CmdLen] = (u8)(cal_crc_temp >> 8);
    tmp_Buf[CmdLen + 1] = (u8)(cal_crc_temp);
#ifdef PRINTFDATA
    PrintHexData(ReadChipAddr, tmp_Buf, CmdLen + 2);
#endif
    //--------------------------------------

    if (IIC_SendData(ReadChipAddr, tmp_Buf, CmdLen + 2) != I2C_OK) //发送一组命令 (0x60, 0x40, 0x5A, 0x02, 0x01, 0x00, CRC_H, CRC_L)
    {
//        delay(10000);
//        if (cnt++ >= Timeout)
//        {
//            printfS("数据读取出错\r\n");
//            while (1);
//        }
			return 1;
    }


	if (IIC_RecData(ReadChipAddr, *SEND_80_BUF, Receive_Len_Buf, 2) != I2C_OK)
	{
		return 2;
	}
		
#ifdef PRINTFDATA
    PrintHexData(ReadChipAddr + 1, Receive_Len_Buf, 2);
#endif

//round2
	if (IIC_RecData(ReadChipAddr, *SEND_80_BUF, Receive_Len_Buf, 2) != I2C_OK)
	{
		return 3;
	}


#ifdef PRINTFDATA
    PrintHexData(ReadChipAddr + 1, Receive_Len_Buf, 2);
#endif
//------
	
	IIC_RxBuf[0]  = Receive_Len_Buf[0];               // toner_status;
	RxLengthBuf = Receive_Len_Buf[1];
	if (IIC_RecData(ReadChipAddr, *SEND_82_BUF, ReDataBuf, RxLengthBuf) != I2C_OK)
	{
		return 2;
	}
	
	
    //----------------------------------------------------------------------------------
    //校验接收数据的CRC
    //----------------------------------------------------------------------------------
    if (RxLengthBuf < 2)
    {
        LOG("Data_Receive_Failed!!! \n");
        while (1);
    }
    
    tmp_Buf[0] = Receive_Len_Buf[0];               //回应数据CRC计算第一位, toner_status;
    for (i = 0; i < RxLengthBuf - 2; i++)          //回应数据前rx_count - 2个数据(最后两位为CRC)
    {
        tmp_Buf[i + 1] = ReDataBuf[i];
    }


    //计算CRC并校验
    cal_crc_temp = GetCrc16(tmp_Buf, RxLengthBuf - 1);
    data_crc_temp = (ReDataBuf[RxLengthBuf - 2] << 8) + ReDataBuf[RxLengthBuf - 1];
    if (cal_crc_temp != data_crc_temp)
    {
        LOG("Data_Receive_Failed!!! \n");
		return 3;
    }

    //接收数据存放到IIC_RxBuf中
    for (i = 0; i < RxLengthBuf - 2; i++)
    {
        IIC_RxBuf[i + 1] = ReDataBuf[i];
    }
		
	delay(10000);
//    System_Delay_MS(100);

#ifdef PRINTFDATA
    PrintHexData(ReadChipAddr + 1, IIC_RxBuf, RxLengthBuf);
#endif
	
	return 0;
}

