/****************************************************************************
* 函数名         ：backdoor_changesn
* 函数功能       ：刷新序列号，修改后门flash版本
* 输入           ：无
* 输出           ：无
****************************************************************************/
u8 backdoor_changesn(void)
{
//    u32 SnDataAddr = 0x35000;
    u8 count = 0;
    static u8 i = 0;
    char new_version[10] = {0}; //更新的flash版本
	u8 upgrader_data[0xF00] = {0};

	
    //Step1 刷新序列号区的数据
    if (i < 10) //; i < 10; i++)            //需要刷新几套数据
    {
		read_file_from_flash(array[i] - 1, upgrader_data);
		LOG("DD1\r\n");
		if (update_sndata(EEDATA_SN_ADDR + (SN_ADDR_STEP * i), (u8*)upgrader_data + 2, SN_LEN - 4) != 0)
		{
			LOG("ERROR 1\r\n");
			count++;
		}
		LOG("num:%d\r\n", i);
		i++;
		
		return 1;
    }
	
    //Step2 发送命令,使芯片内部从已刷新数据中刷新程序所需数据(耗时...)
    if (update_typedata() != 0)
    {
        LOG("ERROR 2\r\n");
        count++;
    }

    //Step3 发送命令,使芯片内部刷新 更新替换区域与控制区域 UpDataCtlInfo
    if (update_ctldata() != 0)
    {
        LOG("ERROR 3\r\n");
        count++;
    }
	
//	//Step4 发送后门数据,刷新后门数据版本
//	get_file_info(new_version, NULL);
//	osal_memcpy(backdoor_data, new_version, 10);
//    if (update_backdoor(BACKDOOR_BASEADDR, backdoor_data) != 0)
//    {
//        LOG("ERROR 4\r\n");
//        count++;
//    }
	
//    //62命令
//    //ReadOem_Cmd((u8*)CMD_62, 7);
	i = 0;	
    if (count == 0)
    {
        LOG("SUCCESS\r\n");
		return 2;
    }
	return 0;
}

/****************************************************************************
   * 函数名         ：update_sndata
   * 函数功能       ：更新SN序列号数据
   * 输入           ：u32 update_addr 要更新的地址
                                            u8* sndata 要更新的数据
                                            u16 data_len 数据长度
   * 输出           ：0：成功
   ****************************************************************************/
static u8 update_sndata(u32 update_addr, u8* sndata, u16 data_len)
{
    const u8 update_sndata_type = 0x01;
    const u8 change_sn_cmd = 0x7D;
    const u8 section_size = 0xE0;

//	u8 tx_array[0x100] = {0};
    u8 send_round;
    u8 last_size;
    u8 round_cnt;
    u16 data_offset;
    u32 target_addr;
    u16 updata_size;


    send_round = data_len / section_size;  //整轮次数                //0x12
    last_size = data_len % section_size;   //最后空余轮的大小  //0x40

    LOG("LastSize:0x%02X\r\n", last_size);

    data_offset = 0;
    for (round_cnt = 0; round_cnt < send_round; round_cnt++)
    {
//        memset_data(tx_array, 0, 0x100);
        osal_memset(tx_array, 0, 0x100);
        tx_array[0] = 0x40;
        tx_array[1] = change_sn_cmd;

        //升级类型与反码-刷新序列号区
        tx_array[3] = update_sndata_type;    //rx_buf[0]
        tx_array[4] = ~update_sndata_type;   //rx_buf[1]

        //烧录序列号的地址
        target_addr = update_addr + data_offset;
        tx_array[5] = (u8)(target_addr >> 24);    //rx_buf[2]
        tx_array[6] = (u8)(target_addr >> 16);    //rx_buf[3]
        tx_array[7] = (u8)(target_addr >> 8);     //rx_buf[4]
        tx_array[8] = (u8)target_addr;                //rx_buf[5]

        //烧录的大小
        updata_size = section_size;
        tx_array[9] = (u8)(updata_size >> 8);     //rx_buf[6]
        tx_array[10] = (u8)updata_size;               //rx_buf[7]

        //烧录的数据
//        memcpy_data(tx_array + 11, sndata + DataOffset, updata_size);
        osal_memcpy(tx_array + 11, sndata + data_offset, updata_size);

        //烧录的命令有效数据长度
        tx_array[2] = 8 + updata_size;

        read_oem_cmd(tx_array, tx_array[2] + 3);

        if ((iic_rxbuf[0] != (u8)update_sndata_type) || (iic_rxbuf[1] != (u8)(~update_sndata_type)) || (iic_rxbuf[2] != 0x00))
        {
            LOG("X1");
            return 1;
        }
        data_offset += updata_size;
    }

    if (last_size)      //如果有剩余的数据
    {
//        memset_data(tx_array, 0, 0x100);
        osal_memset(tx_array, 0, 0x100);
        tx_array[0] = 0x40;
        tx_array[1] = change_sn_cmd;

        //升级类型与反码-刷新序列号区
        tx_array[3] = update_sndata_type;    //rx_buf[0]
        tx_array[4] = ~update_sndata_type;   //rx_buf[1]

        //烧录序列号的地址
        target_addr = update_addr + data_offset;
        tx_array[5] = (u8)(target_addr >> 24);    //rx_buf[2]
        tx_array[6] = (u8)(target_addr >> 16);    //rx_buf[3]
        tx_array[7] = (u8)(target_addr >> 8);     //rx_buf[4]
        tx_array[8] = (u8)target_addr;                //rx_buf[5]

        //烧录的大小,最后一轮的剩余大小,0x14//0x40
        updata_size = last_size;
        tx_array[9] = (u8)(updata_size >> 8);     //rx_buf[6]
        tx_array[10] = (u8)updata_size;               //rx_buf[7]

        //烧录的数据
//        memcpy_data(tx_array + 11, sndata + DataOffset, updata_size);
        osal_memcpy(tx_array + 11, sndata + data_offset, updata_size);

        //烧录的命令有效数据长度
        tx_array[2] = 8 + updata_size;

        read_oem_cmd(tx_array, tx_array[2] + 3);

        if ((iic_rxbuf[0] != (u8)update_sndata_type) || (iic_rxbuf[1] != (u8)(~update_sndata_type)) || (iic_rxbuf[2] != 0))
        {
            LOG("X2");
            return 1;
        }
        data_offset += updata_size;
    }

    return 0;
}


/****************************************************************************
* 函数名         ：update_typedata
* 函数功能       ：更新Type数据
* 输入           ：无
* 输出           ： 0：成功
****************************************************************************/
static u8 update_typedata(void)
{
    u8 chip_update_typedata[7] = {0x40, 0x7D, 0x04, 0x02, 0xFD, 0, 0};

    //注意需要确定芯片型号
    chip_update_typedata[5] = 1;   // 1 90X 2 95X 3 97X
//    ReadOem_Cmd_WithDelay(UpDataTypeData, 7, 1000);
    read_oem_cmd_withdelay(chip_update_typedata, 7, 1000);
    if ((iic_rxbuf[0] != 2) || (iic_rxbuf[1] != 0xFD) || (iic_rxbuf[2] != 0))
    {
        return 1;
    }

    return 0;
}


/****************************************************************************
* 函数名         ：update_ctldata
* 函数功能       ：更新ctl数据
* 输入           ：无
* 输出           ： 0：成功
****************************************************************************/
static u8 update_ctldata(void)
{
    u8 chip_update_ctldata[7] = {0x40, 0x7D, 0x04, 0x03, 0xFC, 0, 0};

    read_oem_cmd_withdelay(chip_update_ctldata, 7, 10);
    if ((iic_rxbuf[0] != 3) || (iic_rxbuf[1] != 0xFC) || (iic_rxbuf[2] != 0))
    {
        return 1;
    }

    return 0;
}


/****************************************************************************
* 函数名         ：update_backdoor
* 函数功能       ：更新后门数据
* 输入           ：u32 backdoor_addr        后门地址
                                    u8* backdoor                要更新的后门数据
* 输出           ： 0：成功
****************************************************************************/
static u8 update_backdoor(u32 backdoor_addr, u8* backdoor)
{
    const u8 update_backdoor_cmd = 0x04;
    const u8 change_sn_cmd = 0x7D;
    const u8 section_size = 0x80;
//      const u8 SectionSize_flash_version = 0x0A;
//	u8 tx_array[0x100];
	
//    memset_data(tx_array, 0, 0x100);
    osal_memset(tx_array, 0, 0x100);
    tx_array[0] = 0x40;
    tx_array[1] = change_sn_cmd;

    //升级类型与反码-刷新序列号区
    tx_array[3] = update_backdoor_cmd;    //rx_buf[0]
    tx_array[4] = ~update_backdoor_cmd;   //rx_buf[1]

    //烧录序列号的地址
    tx_array[5] = (u8)(backdoor_addr >> 24);    //rx_buf[2]
    tx_array[6] = (u8)(backdoor_addr >> 16);    //rx_buf[3]
    tx_array[7] = (u8)(backdoor_addr >> 8);     //rx_buf[4]
    tx_array[8] = (u8)backdoor_addr;                //rx_buf[5]

    //烧录的大小
    tx_array[9] = (u8)(section_size >> 8);     //rx_buf[6]
    tx_array[10] = (u8)section_size;               //rx_buf[7]
//      tx_array[9] = (u8)(section_size >> 8);     //rx_buf[6]
//    tx_array[10] = (u8)section_size;               //rx_buf[7]

    //烧录的数据
//    memcpy_data(tx_array + 11, backdoor, section_size);
    osal_memcpy(tx_array + 11, backdoor, section_size);
//      osal_memcpy(tx_array + 11, backdoor, SectionSize_flash_version);


    //烧录的命令有效数据长度
    tx_array[2] = 8 + section_size;
//      tx_array[2] = 8 + SectionSize_flash_version;

    read_oem_cmd_withdelay(tx_array, tx_array[2] + 3, 0x20);

    if ((iic_rxbuf[0] != (u8)update_backdoor_cmd) || (iic_rxbuf[1] != (u8)(~update_backdoor_cmd)) || (iic_rxbuf[2] != 0))
    {
        LOG("ReadDataBackDoor_Fail\r\n");
        return 1;
    }

    return 0;
}


