* 函数名         ：read_data_backdoor
* 函数功能       ：读后门数据
* 输入           ：无
* 输出           ： 0：成功
****************************************************************************/
static u8 read_data_backdoor(void)
{
	u8 array_readbackdoor[7] = {0x40, 0x78, 0x04, 0x2A, 0xED, 0xAB, 0x72};

    LOG("ReadBackDoor\r\n");
//    read_oem_cmd(tx_array, 7);
	read_oem_cmd(array_readbackdoor, 7);
    LOG("\r\n");

//    if ((iic_rxbuf[0] != (u8)update_backdoor) || (iic_rxbuf[1] != (u8)(~update_backdoor)) || (iic_rxbuf[2] != 0))
//    {
//        return 1;
//    }

    return 0;
}




/****************************************************************************
* 函数名         ：read_oem_cmd
* 函数功能       ：读OEM指令
* 输入           ：u8* cmd_buf  要发送的指令
                   u8 cmd_len 指令长度
* 输出           ：无
****************************************************************************/
static u8 read_oem_cmd(u8* cmd_buf, u8 cmd_len)
{
    int i;
    u8 cnt;

    u8 SEND_80_BUF[1] = {0x80};
    u8 SEND_82_BUF[1] = {0x82};
    u8 receive_len_buf[2];
    u8 re_data_buf[0x100];
//    u8 tx_array[0x100] = {0};
    u16 cal_crc_temp;
    u16 data_crc_temp;

	osal_memset(tx_array, 0, 0x100);
    osal_memset(iic_rxbuf, 0, 0x100);
    //------------------------------------------
    //例如传入 0x40, 0x5A, 0x02, 0x01, 0x00
    //------------------------------------------
    //计算发送命令的CRC
    tx_array[0] = cmd_buf[1];           //5A
    for (i = 0; i < cmd_len - 3; i++)
    {
        tx_array[i + 1] = cmd_buf[3 + i]; //01 00
    }
    cal_crc_temp = GetCrc16(tx_array, cmd_len - 2);

    //-------------------------------------
    //将传进的命令加上CRC，存到tx_array中
    for (i = 0; i < cmd_len; i++)
    {
        tx_array[i] = cmd_buf[i];
    }
    tx_array[cmd_len] = (u8)(cal_crc_temp >> 8);
    tx_array[cmd_len + 1] = (u8)(cal_crc_temp);

//		LOG("tx_array:\r\n");
//		print_hex(tx_array,sizeof(tx_array));
//		LOG("\r\n");
    cnt = 0;
    while (IIC_SendData(read_chip_addr, tx_array, cmd_len + 2) != I2C_OK) //发送一组命令 (0x60, 0x40, 0x5A, 0x02, 0x01, 0x00, CRC_H, CRC_L)
    {
        Delay_us(500);
        if (cnt++ >= Timeout)
        {
            LOG("数据读取出错1\r\n");
//            while (1);
						return 1;
        }
          
    }

    cnt = 0;
    while (IIC_RecData(read_chip_addr, *SEND_80_BUF, receive_len_buf, 2) != I2C_OK)//发送一组命令 (60, 80)并接收状态码与回应长度 (61, toner_status, rx_count)
    {
        Delay_us(500);
        if (cnt++ >= Timeout)
        {
            LOG("数据读取出错2\r\n");
//            while (1);
						return 2;
        }
         
    }

		LOG("80CMD\r\n");
    rx_length_buf = receive_len_buf[1];
    cnt = 0;
    while (IIC_RecData(read_chip_addr, *SEND_82_BUF, re_data_buf, rx_length_buf) != I2C_OK)//发送一组命令 (60, 82)并接收回应数据 (61,xx,xx,xx)
    {
        Delay_us(500);
        if (cnt++ >= Timeout)
        {
            LOG("数据读取出错3\r\n");
//            while (1);
						return 2;
        }
          
    }
    //----------------------------------------------------------------------------------
    //校验接收数据的CRC
    //----------------------------------------------------------------------------------
    if (rx_length_buf < 2)
    {
        LOG("Data_Receive_Failed_1!!! \n");
//        while (1);
				return 3;
    }
    tx_array[0] = receive_len_buf[0];               //回应数据CRC计算第一位, toner_status;
    for (i = 0; i < rx_length_buf - 2; i++)          //回应数据前rx_count - 2个数据(最后两位为CRC)
    {
        tx_array[i + 1] = re_data_buf[i];
    }

    //计算CRC并校验
    cal_crc_temp = GetCrc16(tx_array, rx_length_buf - 1);
		LOG("receive_len_buf:\r\n");
		print_hex(receive_len_buf, sizeof(receive_len_buf));
		LOG("\r\n");
		LOG("rx_length_buf:%02X\r\n",rx_length_buf);
		LOG("re_data_buf:\r\n");
		print_hex(re_data_buf, rx_length_buf);
		LOG("\r\n");

    data_crc_temp = (re_data_buf[rx_length_buf - 2] << 8) + re_data_buf[rx_length_buf - 1];
    if (cal_crc_temp != data_crc_temp)
    {
		LOG("cal_crc_temp:%X",cal_crc_temp);
		LOG("data_crc_temp:%X",data_crc_temp);
        LOG("Data_Receive_Failed_2!!! \n");
//        while (1);
        return 4;
    }

//		LOG("IIC_RxBuf:\r\n");
    //接收数据存放到iic_rxbuf中
    for (i = 0; i < rx_length_buf; i++)
    {
        iic_rxbuf[i] = re_data_buf[i];

//        LOG("%02X ", iic_rxbuf[i]);
    }
//    LOG("\r\n");

    Delay_ms(100);
    return 0;

}



/****************************************************************************
* 函数名         ：read_oem_cmd_withdelay
* 函数功能       ：读OEM指令并等待
* 输入           ：u8* cmd_buf 要发送的指令
                                    u8 cmd_len 指令长度
                                    u32 delay_ms 等待时长
* 输出           ：无
****************************************************************************/
static u8 read_oem_cmd_withdelay(u8* cmd_buf, u8 cmd_len, u32 delay_ms)
{
    int i;
    u8 cnt;

    u8 SEND_80_BUF[1] = {0x80};
    u8 SEND_82_BUF[1] = {0x82};
    u8 receive_len_buf[2];
    u8 re_data_buf[0x100];
//    u8 tx_array[0x100];
    u16 cal_crc_temp;
    u16 data_crc_temp;

	osal_memset(tx_array, 0, 0x100);
    osal_memset(iic_rxbuf, 0, 0x100);
    //计算发送命令的CRC
    tx_array[0] = cmd_buf[1];           //5A
    for (i = 0; i < cmd_len - 3; i++)
    {
        tx_array[i + 1] = cmd_buf[3 + i]; //01 00
    }
		cal_crc_temp = GetCrc16(tx_array, cmd_len - 2);
	
    //-------------------------------------
    //将传进的命令加上CRC，存到tx_array中
    for (i = 0; i < cmd_len; i++)
    {
        tx_array[i] = cmd_buf[i];
    }
    tx_array[cmd_len] = (u8)(cal_crc_temp >> 8);
    tx_array[cmd_len + 1] = (u8)(cal_crc_temp);

    //--------------------------------------
    cnt = 0;
    while (IIC_SendData(read_chip_addr, tx_array, cmd_len + 2) != I2C_OK)//发送一组命令 (0x60, 0x40, 0x5A, 0x02, 0x01, 0x00)
    {
        Delay_us(1000);
        if (cnt++ >= Timeout)
        {
            LOG("数据读取出错\r\n");
//            while (1);
						return 1;
        }
    }
    //======================
    Delay_ms(delay_ms);
    //======================

    //发送一组命令 (60, 80)并//接收状态码与回应长度 (61, toner_status, rx_count)
    cnt = 0;
    while (IIC_RecData(read_chip_addr, *SEND_80_BUF, receive_len_buf, 2) != I2C_OK)
    {
        Delay_us(1000);
        if (cnt++ >= Timeout)
        {
//            while (1);
					return 2;
        }
    }

    //发送一组命令 (60, 82)并//接收回应数据 (61,xx,xx,xx)
    cnt = 0;
    rx_length_buf = receive_len_buf[1];
    while (IIC_RecData(read_chip_addr, *SEND_82_BUF, re_data_buf, rx_length_buf) != I2C_OK)
    {
        Delay_us(1000);
        if (cnt++ >= Timeout)
        {
//            while (1);
					return 3;
        }
    }

    //----------------------------------------------------------------------------------
    //校验接收数据的CRC
    //----------------------------------------------------------------------------------
    if (rx_length_buf < 2)
    {
        LOG("Data_Receive_Failed!!! \n");
//        while (1);
				return 4;
    }
    tx_array[0] = receive_len_buf[0];               //回应数据CRC计算第一位, toner_status;
    for (i = 0; i < rx_length_buf - 2; i++)          //回应数据前rx_count - 2个数据(最后两位为CRC)
    {
        tx_array[i + 1] = re_data_buf[i];
    }

    //计算CRC并校验
    cal_crc_temp = GetCrc16(tx_array, rx_length_buf - 1);
	
    data_crc_temp = (re_data_buf[rx_length_buf - 2] << 8) + re_data_buf[rx_length_buf - 1];
    if (cal_crc_temp != data_crc_temp)
    {
        LOG("Data_Receive_Failed!!! \n");
//        while (1);
				return 5;
    }

    //接收数据存放到iic_rxbuf中
    for (i = 0; i < rx_length_buf; i++)
    {
        iic_rxbuf[i] = re_data_buf[i];
    }

    Delay_ms(100);
		return 0;
}
